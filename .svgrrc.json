{
  "typescript": true,
  "dimensions": false,
  "replaceAttrValues": {
    "#000": "currentColor",
    "#000000": "currentColor",
    "black": "currentColor"
  },
  "svgProps": {
    "stroke": "currentColor",
    "strokeWidth": "2",
    "strokeLinecap": "round",
    "strokeLinejoin": "round",
    "fill": "none"
  },
  "svgo": true,
  "svgoConfig": {
    "plugins": [
      {
        "name": "preset-default",
        "params": {
          "overrides": {
            "removeViewBox": false
          }
        }
      },
      {
        "name": "removeAttrs",
        "params": {
          "attrs": "path:(stroke|stroke-width|stroke-linecap|stroke-linejoin)"
        }
      }
    ]
  }
}
